generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
}

enum Consent {
  Yes
  No
}

enum DownloadSource {
  participant
  admin
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  /// Always stored lower-cased.
  email        String    @unique
  name         String
  passwordHash String    @map("password_hash")
  role         Role      @default(ADMIN)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  lastLoginAt  DateTime? @map("last_login_at")

  sessions          Session[]
  downloads         DownloadEvent[]
  settingsUpdates   CertificateSettings[]
  reviewedResponses Response[]            @relation("ResponseReviewer")
  rosterEntries     RosterEntry[]
  reviewedUpdates   ResponseUpdate[]      @relation("UpdateReviewer")

  @@map("users")
}

/// Server-side session. `id` is the SHA-256 of the cookie token, so a
/// leaked database can't be used to hijack sessions.
model Session {
  id         String   @id
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")
  expiresAt  DateTime @map("expires_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  userAgent  String?  @map("user_agent")
  ip         String?

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

enum ApprovalStatus {
  pending
  approved
  rejected
}

model Response {
  id               String   @id @default(uuid()) @db.Uuid
  /// Generated on submit, but only shown to the participant and accepted by
  /// verification once the response is approved.
  certId           String   @unique @map("cert_id")
  name             String
  /// Where approval / rejection emails go. Unique: one response, and so one
  /// certificate, per email address. Later submissions from the same address
  /// replace a pending one or become update requests.
  email            String   @unique
  opco             String
  consent          Consent
  /// { [questionId]: chosen option }
  answers          Json     @db.JsonB
  verificationCode String   @unique @map("verification_code")
  submittedAt      DateTime @default(now()) @map("submitted_at")

  /// Counter cache of participant downloads (admin downloads don't count),
  /// kept in sync in the same transaction that logs the event.
  participantDownloads Int       @default(0) @map("participant_downloads")
  lastDownloadedAt     DateTime? @map("last_downloaded_at")

  /// Nothing is issued until approved (by an admin, or the participant list).
  status          ApprovalStatus @default(pending)
  /// Unguessable token behind the participant's private status link.
  accessToken     String?        @unique @map("access_token")
  reviewedAt      DateTime?      @map("reviewed_at")
  reviewedById    String?        @map("reviewed_by_id") @db.Uuid
  reviewedBy      User?          @relation("ResponseReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  /// True when approved automatically from the participant list.
  autoApproved    Boolean        @default(false) @map("auto_approved")
  rejectionReason String?        @map("rejection_reason")

  downloads DownloadEvent[]
  updates   ResponseUpdate[]

  @@index([status])
  @@index([submittedAt])
  @@index([opco])
  @@index([participantDownloads])
  @@map("responses")
}

model DownloadEvent {
  id           String         @id @default(uuid()) @db.Uuid
  responseId   String         @map("response_id") @db.Uuid
  response     Response       @relation(fields: [responseId], references: [id], onDelete: Cascade)
  source       DownloadSource
  downloadedAt DateTime       @default(now()) @map("downloaded_at")
  /// The admin who downloaded it (null for participants).
  userId       String?        @map("user_id") @db.Uuid
  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([responseId, downloadedAt])
  @@map("download_events")
}

/// Single-row table (id = 1).
model CertificateSettings {
  id          Int      @id @default(1)
  trainerName String   @default("") @map("trainer_name")
  legacyDates String   @default("") @map("dates")
  startDate   String   @default("") @map("start_date")
  endDate     String   @default("") @map("end_date")
  /// PNG data URL.
  signature   String   @default("")
  /// Default certificate design: "classic" (Minimalist) or "modern" (Styled).
  designVariant String @default("classic") @map("design_variant")
  /// Admin addresses emailed about new submissions and update requests (admin-only; never sent publicly).
  notifyEmails  String[] @default([]) @map("notify_emails")
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("certificate_settings")
}

/// Expected participants. A submission whose email (or name) matches an
/// entry is approved automatically; everyone else waits for an admin.
model RosterEntry {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @default("")
  /// Lower-cased; null when only a name was given.
  email       String?  @unique
  /// Lower-cased, accents removed, words sorted — so "Doe John" matches "John Doe".
  nameKey     String   @default("") @map("name_key")
  createdAt   DateTime @default(now()) @map("created_at")
  createdById String?  @map("created_by_id") @db.Uuid
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([nameKey])
  @@map("roster_entries")
}

/// A change a participant asked for after their certificate was approved
/// (they submitted the form again with the same email). It only replaces the
/// response's details once an admin approves it; the certificate keeps its ID.
model ResponseUpdate {
  id              String         @id @default(uuid()) @db.Uuid
  responseId      String         @map("response_id") @db.Uuid
  response        Response       @relation(fields: [responseId], references: [id], onDelete: Cascade)
  name            String
  opco            String
  consent         Consent
  answers         Json           @db.JsonB
  status          ApprovalStatus @default(pending)
  requestedAt     DateTime       @default(now()) @map("requested_at")
  reviewedAt      DateTime?      @map("reviewed_at")
  reviewedById    String?        @map("reviewed_by_id") @db.Uuid
  reviewedBy      User?          @relation("UpdateReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  rejectionReason String?        @map("rejection_reason")

  @@index([responseId, status])
  @@index([status])
  @@map("response_updates")
}
