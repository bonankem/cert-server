# PostgreSQL
DATABASE_URL=
DATABASE_URL_POOLED=

# First admin account (npm run db:seed). Leave the password empty to generate one.
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=

SESSION_TTL_HOURS=12

# Production (client on Vercel proxying /api to this server on Render):
#   COOKIE_SECURE=true   – HTTPS only session cookie
#   TRUST_PROXY=2        – proxy hops in front of the app (Vercel + Render)
COOKIE_SECURE=
TRUST_PROXY=

# Only needed if a browser calls this API directly from another origin.
CORS_ORIGIN=

# Public address of the client app (links in emails)
APP_URL=https://cert-client.vercel.app

# Email via Amazon SES. Leave the keys empty to disable sending.
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MAIL_FROM="StableNet Training <no-reply@miro.zoracom.com>"

# Fallback admin notification addresses (comma-separated), used only while none are saved in
# the dashboard (Settings → Admin notification emails). Empty = none.
ADMIN_NOTIFY_EMAILS=
